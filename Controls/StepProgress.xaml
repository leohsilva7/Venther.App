<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Venther.App.Controls.StepProgress"
             x:Name="this">
    <VerticalStackLayout Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="{Binding StepText, Source={x:Reference this}}"
                   FontFamily="InterSemiBold"
                   FontSize="12"
                   TextColor="{StaticResource TextSecondary}"
                   VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="{Binding PercentageText, Source={x:Reference this}}"
                   FontFamily="InterBold"
                   FontSize="12"
                   TextColor="{StaticResource BrandPrimary}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Barra de Progresso -->
        <Border HeightRequest="6"
                StrokeThickness="0"
                BackgroundColor="{StaticResource BorderDefault}"
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="3" />
            </Border.StrokeShape>

            <ProgressBar Progress="{Binding ProgressValue, Source={x:Reference this}}"
                         ProgressColor="{StaticResource BrandPrimary}"
                         BackgroundColor="Transparent"
                         HeightRequest="6" />
        </Border>
    </VerticalStackLayout>
</ContentView>