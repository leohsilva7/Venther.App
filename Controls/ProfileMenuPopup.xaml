<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Venther.App.Controls.ProfileMenuPopup"
               Color="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <Border WidthRequest="340"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="1"
            Stroke="{StaticResource AuthBorder}"
            BackgroundColor="{StaticResource White}"
            Padding="20"
            Margin="20"
            HorizontalOptions="Center"
            VerticalOptions="Center">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.15" Offset="0, 8" Radius="16" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="16">

            <!-- STATE 1: MENU PRINCIPAL DE PERFIL -->
            <VerticalStackLayout x:Name="ProfileMenuLayout"
                                 Spacing="16"
                                 IsVisible="True">

                <!-- Header: Iniciais, Nome, Email e Badge -->
                <Grid ColumnDefinitions="52, *"
                      ColumnSpacing="14"
                      VerticalOptions="Center">

                    <!-- Avatar Circular com Iniciais -->
                    <Border Grid.Column="0"
                            WidthRequest="52"
                            HeightRequest="52"
                            StrokeShape="RoundRectangle 26"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Primary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Label x:Name="InitialsLabel"
                               Text="TE"
                               FontFamily="InterBold"
                               FontSize="18"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Textos: Nome, Email, Role -->
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="4"
                                         VerticalOptions="Center">
                        <Label x:Name="NameLabel"
                               Text="Técnico"
                               FontFamily="InterSemiBold"
                               FontSize="16"
                               TextColor="{StaticResource OnSurface}"
                               LineBreakMode="TailTruncation" />

                        <Label x:Name="EmailLabel"
                               Text="tecnico@venther.com"
                               Style="{StaticResource BodySmall}"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               LineBreakMode="TailTruncation" />

                        <HorizontalStackLayout Spacing="6" Margin="0, 2, 0, 0">
                            <!-- Badge de Perfil em Pílula -->
                            <Border StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource SurfaceVariant}"
                                    Padding="8, 2">
                                <Label x:Name="RoleLabel"
                                       Text="TÉCNICO"
                                       FontFamily="InterSemiBold"
                                       FontSize="10"
                                       CharacterSpacing="0.5"
                                       TextColor="{StaticResource Primary}" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- Separador Visual Sutil -->
                <BoxView HeightRequest="1"
                         Color="{StaticResource AuthBorder}"
                         HorizontalOptions="Fill" />

                <!-- Ações do Menu -->
                <VerticalStackLayout Spacing="10">
                    <!-- Botão de Sair da Conta -->
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{StaticResource ErrorBorder}"
                            BackgroundColor="{StaticResource ErrorBg}"
                            HeightRequest="48"
                            Padding="12, 0"
                            SemanticProperties.Description="Sair da conta">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPromptLogoutTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *"
                              ColumnSpacing="10"
                              VerticalOptions="Center">
                            <Image Grid.Column="0"
                                   Source="log_out.svg"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource Error}" />
                                </Image.Behaviors>
                            </Image>
                            <Label Grid.Column="1"
                                   Text="Sair da conta"
                                   FontFamily="InterMedium"
                                   FontSize="14"
                                   TextColor="{StaticResource Error}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Botão Cancelar / Fechar -->
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{StaticResource AuthBorder}"
                            BackgroundColor="{StaticResource Surface}"
                            HeightRequest="44"
                            SemanticProperties.Description="Fechar menu">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="Fechar"
                               FontFamily="InterMedium"
                               FontSize="14"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- STATE 2: CONFIRMAÇÃO INTEGRADA DE LOGOUT -->
            <VerticalStackLayout x:Name="ConfirmLogoutLayout"
                                 Spacing="16"
                                 IsVisible="False">

                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border WidthRequest="48"
                            HeightRequest="48"
                            StrokeShape="RoundRectangle 24"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource ErrorBg}"
                            HorizontalOptions="Center">
                        <Image Source="log_out.svg"
                               WidthRequest="22"
                               HeightRequest="22"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource Error}" />
                            </Image.Behaviors>
                        </Image>
                    </Border>

                    <Label Text="Encerrar sessão?"
                           FontFamily="InterSemiBold"
                           FontSize="18"
                           TextColor="{StaticResource OnSurface}"
                           HorizontalOptions="Center" />

                    <Label Text="Tem certeza de que deseja sair da sua conta? Você precisará entrar novamente para acessar seus chamados e telemetria."
                           Style="{StaticResource BodySmall}"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Separador -->
                <BoxView HeightRequest="1"
                         Color="{StaticResource AuthBorder}"
                         HorizontalOptions="Fill" />

                <!-- Botões de Ação da Confirmação -->
                <VerticalStackLayout Spacing="10">
                    <!-- Confirmar Saída com Loading Indicator -->
                    <Border x:Name="ConfirmLogoutButton"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Error}"
                            HeightRequest="48"
                            SemanticProperties.Description="Confirmar saída da conta">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnConfirmLogoutTapped" />
                        </Border.GestureRecognizers>
                        <Grid HorizontalOptions="Center" VerticalOptions="Center">
                            <Label x:Name="ConfirmLogoutText"
                                   Text="Confirmar saída"
                                   FontFamily="InterMedium"
                                   FontSize="14"
                                   TextColor="{StaticResource White}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center" />
                            <ActivityIndicator x:Name="LogoutIndicator"
                                               IsRunning="False"
                                               IsVisible="False"
                                               Color="{StaticResource White}"
                                               WidthRequest="22"
                                               HeightRequest="22"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Botão Voltar -->
                    <Border x:Name="BackButton"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{StaticResource AuthBorder}"
                            BackgroundColor="{StaticResource Surface}"
                            HeightRequest="44"
                            SemanticProperties.Description="Voltar ao perfil">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackToProfileTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="Voltar"
                               FontFamily="InterMedium"
                               FontSize="14"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
