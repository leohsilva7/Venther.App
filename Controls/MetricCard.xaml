<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Venther.App.Controls.MetricCard"
             x:Name="Root">
    <Border Style="{StaticResource Card}">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding Title, Source={x:Reference Root}}"
                       Style="{StaticResource BodySmall}"
                       LineBreakMode="WordWrap" VerticalOptions="Center" />
                <Image Grid.Column="1" WidthRequest="15" HeightRequest="15" VerticalOptions="Center"
                       Source="{Binding IconSource, Source={x:Reference Root}}">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior
                            TintColor="{Binding IconColor, Source={x:Reference Root}}" />
                    </Image.Behaviors>
                </Image>
            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="4" VerticalOptions="End">
                <Label LineBreakMode="NoWrap">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Value, Source={x:Reference Root}}"
                                  FontFamily="InterSemiBold" FontSize="24"
                                  TextColor="{Binding ValueColor, Source={x:Reference Root}}" />
                            <Span Text="{Binding UnitText, Source={x:Reference Root}}"
                                  FontFamily="InterRegular" FontSize="13"
                                  TextColor="{StaticResource OnSurface}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <HorizontalStackLayout Spacing="4">
                    <Image WidthRequest="10" HeightRequest="10" VerticalOptions="Center"
                           Source="{Binding TrendIconSource, Source={x:Reference Root}}">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior
                                TintColor="{Binding TrendColor, Source={x:Reference Root}}" />
                        </Image.Behaviors>
                    </Image>
                    <Label Text="{Binding Caption, Source={x:Reference Root}}"
                           FontFamily="InterSemiBold" FontSize="11" CharacterSpacing="0.55"
                           TextColor="{Binding TrendColor, Source={x:Reference Root}}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>