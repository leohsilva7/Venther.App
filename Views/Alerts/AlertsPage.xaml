<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Venther.App.ViewModels"
             xmlns:controls="clr-namespace:Venther.App.Controls"
             xmlns:models="clr-namespace:Venther.App.Models"
             x:Class="Venther.App.Views.Alerts.AlertsPage"
             x:DataType="vm:AlertsViewModel"
             Shell.NavBarIsVisible="False"
             HideSoftInputOnTapped="True"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto, *">

        <!-- Row 0: Header com título + SegmentedControl acoplado -->
        <controls:AppHeader Grid.Row="0"
                            Title="Alertas"
                            ShowSyncButton="True"
                            ShowBellButton="False"
                            SyncCommand="{Binding RefreshCommand}">
            <controls:AppHeader.BottomContent>
                <controls:SegmentedControl ItemsSource="{Binding FilterSegments}"
                                          SelectedIndex="{Binding SelectedSegmentIndex, Mode=TwoWay}"
                                          Margin="0, 4, 0, 0" />
            </controls:AppHeader.BottomContent>
        </controls:AppHeader>

        <!-- Row 1: Scrollable content -->
        <Grid Grid.Row="1" RowDefinitions="Auto, *">
            <!-- Offline Banner -->
            <Border Grid.Row="0"
                    IsVisible="{Binding IsOffline}"
                    BackgroundColor="{StaticResource SurfaceVariant}"
                    Stroke="{StaticResource Outline}"
                    StrokeThickness="0"
                    Padding="16, 8">
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="wifi.svg"
                           WidthRequest="14"
                           HeightRequest="14"
                           Aspect="AspectFit"
                           VerticalOptions="Center">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{StaticResource OnSurfaceVariant}" />
                        </Image.Behaviors>
                    </Image>
                    <Label Text="{Binding OfflineMessage}"
                           Style="{StaticResource Caption}"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <RefreshView Grid.Row="1"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         RefreshColor="{StaticResource Primary}">
            <CollectionView ItemsSource="{Binding FilteredAlerts}"
                            SelectionMode="None"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

            <!-- Header: Contagem de alertas -->
            <CollectionView.Header>
                <Label Margin="20, 12, 20, 8"
                       Style="{StaticResource BodySmall}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding FilteredAlerts.Count}" FontFamily="InterSemiBold" TextColor="{StaticResource OnSurface}" />
                            <Span Text=" alertas encontrados" TextColor="{StaticResource OnSurfaceVariant}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </CollectionView.Header>

            <!-- Item Template -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AlertItem">
                    <controls:AlertCard Alert="{Binding .}"
                                       ActionCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, Path=ViewDetailCommand}"
                                       Margin="20, 0, 20, 12" />
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Empty / Error state -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Margin="20, 48">
                    <VerticalStackLayout Spacing="12"
                                         IsVisible="{Binding HasError}"
                                         HorizontalOptions="Center">
                        <Label Text="{Binding ErrorMessage}"
                               Style="{StaticResource BodySmall}"
                               TextColor="{StaticResource Error}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Tentar novamente"
                                Command="{Binding RefreshCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="8"
                                HeightRequest="44"
                                Padding="20, 0"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding HasError}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>
                        <Label Text="Nenhum alerta encontrado"
                               Style="{StaticResource Heading}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding EmptyMessage}"
                               Style="{StaticResource BodySmall}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- Footer: clearance for tab bar -->
            <CollectionView.Footer>
                <BoxView HeightRequest="80" Color="Transparent" />
            </CollectionView.Footer>

            </CollectionView>
        </RefreshView>
        </Grid>

        <!-- Loading overlay -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

    </Grid>

</ContentPage>
