<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Venther.App.ViewModels"
             xmlns:controls="clr-namespace:Venther.App.Controls"
             x:Class="Venther.App.Views.WorkOrders.WorkOrderDetailPage"
             x:DataType="vm:WorkOrderDetailViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="64, *, Auto">

        <!-- ===== Header: voltar + título + ações ===== -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              ColumnSpacing="8"
              Padding="24, 0"
              BackgroundColor="{StaticResource Background}">
            
            <ImageButton Grid.Column="0"
                         Source="arrow_left.svg"
                         WidthRequest="44"
                         HeightRequest="44"
                         Padding="14"
                         BackgroundColor="Transparent"
                         Command="{Binding BackCommand}"
                         SemanticProperties.Description="Voltar">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{StaticResource OnSurface}" />
                </ImageButton.Behaviors>
            </ImageButton>

            <Label Grid.Column="1"
                   Text="{Binding Title}"
                   Style="{StaticResource Heading}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />

            <Border Grid.Column="2"
                    WidthRequest="32"
                    HeightRequest="32"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource Primary}"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Image Source="user.svg"
                       WidthRequest="12"
                       HeightRequest="12">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="White" />
                    </Image.Behaviors>
                </Image>
            </Border>
        </Grid>

        <!-- ===== Conteúdo com Scroll ===== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24, 0, 24, 24" Spacing="20">

                <!-- 1. Faixa de Alerta / SLA -->
                <Border BackgroundColor="{StaticResource AccentContainer}"
                        StrokeThickness="0"
                        Padding="16, 12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                WidthRequest="36"
                                HeightRequest="36"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource Accent}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Image Source="clock.svg"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource White}" />
                                </Image.Behaviors>
                            </Image>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding SlaStatusText}"
                                   FontFamily="InterSemiBold"
                                   FontSize="11"
                                   CharacterSpacing="0.5"
                                   TextColor="{StaticResource AccentText}" />
                            <Label Text="{Binding SlaRemainingTime, StringFormat='Tempo restante: {0}'}"
                                   FontFamily="InterBold"
                                   FontSize="15"
                                   TextColor="{StaticResource OnAccentContainer}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="2"
                                BackgroundColor="{StaticResource White}"
                                StrokeThickness="0"
                                Padding="8, 4"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                            <Label Text="{Binding PriorityText}"
                                   FontFamily="InterSemiBold"
                                   FontSize="10"
                                   TextColor="{StaticResource AccentText}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Card da Tarefa (título, localização e mini mapa) -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="ORDEM DE SERVIÇO"
                                   Style="{StaticResource Overline}" />
                            <Label Text="{Binding WorkOrder.Title, FallbackValue='Manutenção Corretiva Urgente'}"
                                   FontFamily="InterSemiBold"
                                   FontSize="18"
                                   TextColor="{StaticResource OnSurface}" />
                            <Label Text="{Binding WorkOrder.DeviceName, FallbackValue='Self Contained - Sala de Servidores'}"
                                   Style="{StaticResource BodySmall}"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>

                        <!-- Localização -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Image Source="map_pin.svg"
                                   WidthRequest="16"
                                   HeightRequest="16"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                </Image.Behaviors>
                            </Image>
                            <Label Text="{Binding WorkOrder.Location, FallbackValue='Subsolo · Bloco B · Prédio Principal'}"
                                   FontFamily="InterMedium"
                                   FontSize="13"
                                   TextColor="{StaticResource OnSurface}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Mini Mapa (Placeholder TODO mapa real) -->
                        <Border HeightRequest="130"
                                BackgroundColor="{StaticResource SurfaceVariant}"
                                Stroke="{StaticResource Outline}"
                                StrokeThickness="0.5"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid>
                                <!-- Linhas decorativas do grid / mapa -->
                                <BoxView Color="{StaticResource Outline}"
                                         Opacity="0.15"
                                         HeightRequest="1"
                                         VerticalOptions="Center" />
                                <BoxView Color="{StaticResource Outline}"
                                         Opacity="0.15"
                                         WidthRequest="1"
                                         HorizontalOptions="Center" />

                                <!-- Pin do mapa central -->
                                <VerticalStackLayout HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Spacing="4">
                                    <Border WidthRequest="32"
                                            HeightRequest="32"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource Primary}"
                                            HorizontalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Image Source="navigation.svg"
                                               WidthRequest="16"
                                               HeightRequest="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                                            <Image.Behaviors>
                                                <toolkit:IconTintColorBehavior TintColor="{StaticResource White}" />
                                            </Image.Behaviors>
                                        </Image>
                                    </Border>
                                    <!-- TODO: Substituir por controle de mapa real (Maps SDK) -->
                                    <Label Text="Rota calculada · 12 min (4.2 km)"
                                           FontFamily="InterSemiBold"
                                           FontSize="11"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. Card de Diagnóstico com 3 mini cards de telemetria -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="DIAGNÓSTICO EM TEMPO REAL"
                               Style="{StaticResource Overline}" />

                        <!-- Grid 3 colunas de telemetria -->
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                            <!-- Temp Insuflamento (Normal) -->
                            <controls:MetricCard Grid.Column="0"
                                                 Title="Temp."
                                                 Value="{Binding TempValue}"
                                                 Unit="°C"
                                                 Caption="Normal"
                                                 IconSource="thermometer.svg"
                                                 TrendIconSource="minus.svg"
                                                 IsAlert="False" />

                            <!-- Pressão Linha (Em Alerta - IsAlert=True) -->
                            <controls:MetricCard Grid.Column="1"
                                                 Title="Pressão"
                                                 Value="{Binding PressureValue}"
                                                 Unit="bar"
                                                 Caption="Alerta"
                                                 IconSource="gauge.svg"
                                                 TrendIconSource="trending_up.svg"
                                                 IsAlert="True" />

                            <!-- Delta P (Normal) -->
                            <controls:MetricCard Grid.Column="2"
                                                 Title="Delta P"
                                                 Value="{Binding DeltaPValue}"
                                                 Unit="Pa"
                                                 Caption="Estável"
                                                 IconSource="snowflake.svg"
                                                 TrendIconSource="minus.svg"
                                                 IsAlert="False" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 4. Card de Cliente e Contato Direto -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="CLIENTE E CONTATO"
                               Style="{StaticResource Overline}" />

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource SurfaceVariant}"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Image Source="user.svg"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding ClientName}"
                                       FontFamily="InterSemiBold"
                                       FontSize="14"
                                       TextColor="{StaticResource OnSurface}" />
                                <Label Text="{Binding ContactPerson}"
                                       FontFamily="InterMedium"
                                       FontSize="12"
                                       TextColor="{StaticResource OnSurfaceVariant}" />
                                <Label Text="{Binding ContactRole}"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource AuthMuted}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Botões Ligar e Mensagem -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <!-- Botão Ligar -->
                            <Button Grid.Column="0"
                                    Text="Ligar"
                                    ImageSource="phone.svg"
                                    Command="{Binding CallClientCommand}"
                                    BackgroundColor="{StaticResource SurfaceVariant}"
                                    TextColor="{StaticResource Primary}"
                                    FontFamily="InterSemiBold"
                                    FontSize="13"
                                    CornerRadius="8"
                                    HeightRequest="44" />

                            <!-- Botão Mensagem -->
                            <Button Grid.Column="1"
                                    Text="Mensagem"
                                    ImageSource="message_square.svg"
                                    Command="{Binding MessageClientCommand}"
                                    BackgroundColor="{StaticResource SurfaceVariant}"
                                    TextColor="{StaticResource Primary}"
                                    FontFamily="InterSemiBold"
                                    FontSize="13"
                                    CornerRadius="8"
                                    HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 5. Checklist de Peças e Ferramentas Pré-alocadas -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="PEÇAS E FERRAMENTAS"
                                   Style="{StaticResource Overline}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding ChecklistProgressText}"
                                   FontFamily="InterSemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Lista de Itens Marcáveis -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Checklist}"
                                             Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChecklistItemViewModel">
                                    <Border BackgroundColor="{StaticResource Background}"
                                            StrokeThickness="1"
                                            Stroke="{StaticResource AuthBorder}"
                                            Padding="12, 10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Color="{StaticResource Primary}"
                                                      VerticalOptions="Center" />

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontFamily="InterMedium"
                                                       FontSize="13"
                                                       TextColor="{StaticResource OnSurface}" />
                                                <Label Text="{Binding Code}"
                                                       Style="{StaticResource Caption}"
                                                       TextColor="{StaticResource AuthMuted}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== Rodapé Fixo com Botão CONCLUIR (altura 52, fundo Primary) ===== -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource AuthBorder}"
                StrokeThickness="1"
                Padding="24, 16">
            <Button Text="CONCLUIR CHAMADO"
                    Command="{Binding CompleteOrderCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    FontFamily="InterSemiBold"
                    FontSize="15"
                    HeightRequest="52"
                    CornerRadius="8"
                    HorizontalOptions="Fill" />
        </Border>

    </Grid>
</ContentPage>
