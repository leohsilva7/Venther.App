<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Venther.App.ViewModels"
             xmlns:controls="clr-namespace:Venther.App.Controls"
             xmlns:models="clr-namespace:Venther.App.Models"
             x:Class="Venther.App.Views.WorkOrders.WorkOrdersPage"
             x:DataType="vm:WorkOrdersViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto, *">

        <!-- Row 0: Header com título + botão de filtro -->
        <controls:AppHeader Grid.Row="0"
                            Title="Chamados"
                            ShowSyncButton="True"
                            ShowBellButton="False"
                            ShowFilterButton="True"
                            SyncCommand="{Binding RefreshCommand}"
                            FilterCommand="{Binding OpenFilterCommand}" />

        <!-- Row 1: Lista -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="{StaticResource Primary}">
            <CollectionView ItemsSource="{Binding FilteredWorkOrders}"
                            SelectionMode="None"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

            <!-- Header: SegmentedControl + counter -->
            <CollectionView.Header>
                <VerticalStackLayout Spacing="0">

                    <controls:SegmentedControl ItemsSource="{Binding FilterSegments}"
                                              SelectedIndex="{Binding SelectedSegmentIndex, Mode=TwoWay}"
                                              Margin="20, 16, 20, 0" />

                    <Label Margin="20, 12, 20, 4"
                           Style="{StaticResource BodySmall}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding FilteredWorkOrders.Count}"
                                      FontFamily="InterSemiBold"
                                      TextColor="{StaticResource OnSurface}" />
                                <Span Text=" ordens encontradas"
                                      TextColor="{StaticResource OnSurfaceVariant}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <BoxView HeightRequest="8" Color="Transparent" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Items -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:WorkOrder">
                    <controls:WorkOrderCard WorkOrder="{Binding .}"
                                           Margin="20, 0, 20, 12" />
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Empty / Error state -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Margin="20, 48">
                    <VerticalStackLayout Spacing="12"
                                         IsVisible="{Binding HasError}"
                                         HorizontalOptions="Center">
                        <Label Text="{Binding ErrorMessage}"
                               Style="{StaticResource BodySmall}"
                               TextColor="{StaticResource Error}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Tentar novamente"
                                Command="{Binding RefreshCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="8"
                                HeightRequest="44"
                                Padding="20, 0"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding HasError}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>
                        <Label Text="Nenhum chamado encontrado"
                               Style="{StaticResource Heading}"
                               HorizontalOptions="Center" />
                        <Label Text="Não há ordens de serviço para o filtro selecionado."
                               Style="{StaticResource BodySmall}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- Footer: clearance for tab bar -->
            <CollectionView.Footer>
                <BoxView HeightRequest="80" Color="Transparent" />
            </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

        <!-- Loading overlay -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

    </Grid>

</ContentPage>
