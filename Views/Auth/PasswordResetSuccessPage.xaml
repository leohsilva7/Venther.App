<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Venther.App.ViewModels"
             x:Class="Venther.App.Views.Auth.PasswordResetSuccessPage"
             x:DataType="vm:PasswordResetSuccessViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}"
             Title="Senha Redefinida">

    <ScrollView>
        <Grid RowDefinitions="*, Auto, *"
              Padding="24, 32"
              MinimumHeightRequest="600">

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="24"
                                 MaximumWidthRequest="420"
                                 HorizontalOptions="Fill">

                <!-- Logo & Branding Header -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border WidthRequest="64"
                            HeightRequest="64"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Surface}"
                            HorizontalOptions="Center"
                            Margin="0, 0, 0, 8">
                        <Image Source="logoventher.png"
                               WidthRequest="36"
                               HeightRequest="36"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="VENTHER"
                           FontFamily="InterBold"
                           FontSize="20"
                           CharacterSpacing="1.2"
                           TextColor="{StaticResource LogoBlue}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Auth Card -->
                <Border Style="{StaticResource AuthCard}">
                    <VerticalStackLayout Spacing="24">

                        <!-- Símbolo de Sucesso (ícone circle-check / check_circle em círculo) -->
                        <Border WidthRequest="56"
                                HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource SuccessContainer}"
                                HorizontalOptions="Center">
                            <Image Source="check_circle.svg"
                                   WidthRequest="28"
                                   HeightRequest="28"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource Success}" />
                                </Image.Behaviors>
                            </Image>
                        </Border>

                        <!-- Título e Descrição -->
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="Senha redefinida com sucesso!"
                                   Style="{StaticResource TitleAuth}"
                                   FontSize="22"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="Sua senha foi atualizada. Agora você já pode acessar sua conta normalmente com a nova credencial."
                                   Style="{StaticResource BodySmall}"
                                   TextColor="{StaticResource AuthMuted}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Caixa de Confirmação de Segurança -->
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource AuthBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="16, 14">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                                <Image Grid.Column="0"
                                       Source="shield_check.svg"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       VerticalOptions="Center">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                    </Image.Behaviors>
                                </Image>
                                <Label Grid.Column="1"
                                       Text="Sua conta está protegida e todas as sessões anteriores foram encerradas com segurança."
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource OnSurfaceVariant}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Botão Principal -->
                        <Button Style="{StaticResource PrimaryButton}"
                                Text="Fazer login"
                                Command="{Binding BackToLoginCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                HorizontalOptions="Fill" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
