<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Venther.App.ViewModels"
             xmlns:controls="clr-namespace:Venther.App.Controls"
             x:Class="Venther.App.Views.Auth.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}"
             HideSoftInputOnTapped="True"
             Title="Recuperar Senha">

    <ScrollView>
        <Grid RowDefinitions="*, Auto, *"
              Padding="24, 32"
              MinimumHeightRequest="600">

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="24"
                                 MaximumWidthRequest="420"
                                 HorizontalOptions="Fill">

                <!-- Logo & Branding Header -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border WidthRequest="64"
                            HeightRequest="64"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Surface}"
                            HorizontalOptions="Center"
                            Margin="0, 0, 0, 8">
                        <Image Source="logoventher.png"
                               WidthRequest="36"
                               HeightRequest="36"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="VENTHER"
                           FontFamily="InterBold"
                           FontSize="20"
                           CharacterSpacing="1.2"
                           TextColor="{StaticResource LogoBlue}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Auth Card -->
                <Border Style="{StaticResource AuthCard}">
                    <VerticalStackLayout Spacing="20">

                        <!-- Símbolo de etapa (ícone key-round em círculo de 48) -->
                        <Border WidthRequest="48"
                                HeightRequest="48"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource Surface}"
                                HorizontalOptions="Center">
                            <Image Source="key_round.svg"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                </Image.Behaviors>
                            </Image>
                        </Border>

                        <!-- Título e Descrição -->
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="Recuperar senha"
                                   Style="{StaticResource TitleAuth}"
                                   FontSize="22"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="Informe o e-mail associado à sua conta para receber as instruções de recuperação."
                                   Style="{StaticResource BodySmall}"
                                   TextColor="{StaticResource AuthMuted}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Campo de E-mail -->
                        <controls:AppEntry Label="E-mail"
                                           Placeholder="nome@empresa.com"
                                           Keyboard="Email"
                                           ReturnType="Done"
                                           Text="{Binding Email, Mode=TwoWay}"
                                           HasError="{Binding HasEmailError}"
                                           ErrorMessage="{Binding EmailErrorMessage}" />

                        <!-- Botão Principal -->
                        <Button Style="{StaticResource PrimaryButton}"
                                Text="Enviar instruções"
                                Command="{Binding SendInstructionsCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                HorizontalOptions="Fill" />

                        <!-- Activity Indicator de Carregamento -->
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Primary}"
                                           HeightRequest="24"
                                           HorizontalOptions="Center" />

                        <!-- Botão Voltar para o Login -->
                        <Button Style="{StaticResource LinkButton}"
                                Text="← Voltar para o login"
                                Command="{Binding GoBackCommand}"
                                HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </Border>

                <!-- Footer Support Note -->
                <Label Text="Venther • Manutenção Inteligente de Climatização"
                       Style="{StaticResource Caption}"
                       TextColor="{StaticResource AuthMuted}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
