<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Venther.App.ViewModels"
             xmlns:controls="clr-namespace:Venther.App.Controls"
             x:Class="Venther.App.Views.Auth.ResetPasswordPage"
             x:DataType="vm:ResetPasswordViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}"
             Title="Redefinir Senha">

    <ScrollView>
        <Grid RowDefinitions="*, Auto, *"
              Padding="24, 32"
              MinimumHeightRequest="720">

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="24"
                                 MaximumWidthRequest="420"
                                 HorizontalOptions="Fill">

                <!-- Logo & Branding Header -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border WidthRequest="64"
                            HeightRequest="64"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Surface}"
                            HorizontalOptions="Center"
                            Margin="0, 0, 0, 8">
                        <Image Source="logoventher.png"
                               WidthRequest="36"
                               HeightRequest="36"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="VENTHER"
                           FontFamily="InterBold"
                           FontSize="20"
                           CharacterSpacing="1.2"
                           TextColor="{StaticResource LogoBlue}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Auth Card -->
                <Border Style="{StaticResource AuthCard}">
                    <VerticalStackLayout Spacing="20">

                        <!-- Símbolo de etapa (ícone key-round em círculo de 48) -->
                        <Border WidthRequest="48"
                                HeightRequest="48"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource Surface}"
                                HorizontalOptions="Center">
                            <Image Source="key_round.svg"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                </Image.Behaviors>
                            </Image>
                        </Border>

                        <!-- Título e Subtítulo -->
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="Redefinir senha"
                                   Style="{StaticResource TitleAuth}"
                                   FontSize="22"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="Crie uma nova senha segura para acessar sua conta."
                                   Style="{StaticResource BodySmall}"
                                   TextColor="{StaticResource AuthMuted}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Erro Geral / API -->
                        <Border BackgroundColor="{StaticResource ErrorBg}"
                                Stroke="{StaticResource ErrorBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12, 10"
                                IsVisible="{Binding HasError}">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Image Source="alert_circle.svg"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       VerticalOptions="Center">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Error}" />
                                    </Image.Behaviors>
                                </Image>
                                <Label Text="{Binding ErrorMessage}"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource Error}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Campo 1: Nova Senha -->
                        <controls:AppEntry Label="Nova senha"
                                           Placeholder="Digite sua nova senha"
                                           IsPassword="True"
                                           ReturnType="Next"
                                           Text="{Binding NewPassword, Mode=TwoWay}" />

                        <!-- Indicador de Força de Senha (4 segmentos e classificação textual) -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="Força da senha:"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource OnSurfaceVariant}" />
                                <Label Grid.Column="1"
                                       Text="{Binding StrengthText}"
                                       FontFamily="InterSemiBold"
                                       FontSize="12"
                                       TextColor="{Binding StrengthColor}" />
                            </Grid>

                            <!-- Barra de 4 Segmentos -->
                            <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="6" HeightRequest="4">
                                <!-- Segmento 1 -->
                                <Border Grid.Column="0"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 2"
                                        BackgroundColor="{StaticResource AuthBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSegment1Active}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{Binding StrengthColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- Segmento 2 -->
                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 2"
                                        BackgroundColor="{StaticResource AuthBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSegment2Active}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{Binding StrengthColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- Segmento 3 -->
                                <Border Grid.Column="2"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 2"
                                        BackgroundColor="{StaticResource AuthBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSegment3Active}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{Binding StrengthColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- Segmento 4 -->
                                <Border Grid.Column="3"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 2"
                                        BackgroundColor="{StaticResource AuthBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSegment4Active}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{Binding StrengthColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Requisitos com Check (5 regras da API) -->
                        <VerticalStackLayout Spacing="8">
                            <!-- Requisito 1: Mínimo 8 caracteres -->
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Image Source="check.svg"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           IsVisible="{Binding HasMinLength, Converter={toolkit:InvertedBoolConverter}}">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{StaticResource Outline}" />
                                        </Image.Behaviors>
                                    </Image>
                                    <Image Source="check_circle.svg"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           IsVisible="{Binding HasMinLength}">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{StaticResource Success}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Grid>
                                <Label Text="Mínimo de 8 caracteres (máx. 100)"
                                       Style="{StaticResource Caption}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasMinLength}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource SuccessText}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasMinLength}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>

                            <!-- Requisito 2: Uma letra maiúscula -->
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Image Source="check.svg"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           IsVisible="{Binding HasUppercase, Converter={toolkit:InvertedBoolConverter}}">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{StaticResource Outline}" />
                                        </Image.Behaviors>
                                    </Image>
                                    <Image Source="check_circle.svg"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           IsVisible="{Binding HasUppercase}">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{StaticResource Success}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Grid>
                                <Label Text="Pelo menos uma letra maiúscula"
                                       Style="{StaticResource Caption}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasUppercase}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource SuccessText}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasUppercase}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>

                            <!-- Requisito 3: Uma letra minúscula -->
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Image Source="check.svg"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           IsVisible="{Binding HasLowercase, Converter={toolkit:InvertedBoolConverter}}">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{StaticResource Outline}" />
                                        </Image.Behaviors>
                                    </Image>
                                    <Image Source="check_circle.svg"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           IsVisible="{Binding HasLowercase}">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{StaticResource Success}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Grid>
                                <Label Text="Pelo menos uma letra minúscula"
                                       Style="{StaticResource Caption}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasLowercase}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource SuccessText}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasLowercase}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>

                            <!-- Requisito 4: Pelo menos um número -->
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Image Source="check.svg"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           IsVisible="{Binding HasNumber, Converter={toolkit:InvertedBoolConverter}}">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{StaticResource Outline}" />
                                        </Image.Behaviors>
                                    </Image>
                                    <Image Source="check_circle.svg"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           IsVisible="{Binding HasNumber}">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{StaticResource Success}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Grid>
                                <Label Text="Pelo menos um número"
                                       Style="{StaticResource Caption}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasNumber}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource SuccessText}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasNumber}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>

                            <!-- Requisito 5: Um caractere especial -->
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Image Source="check.svg"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           IsVisible="{Binding HasSpecialChar, Converter={toolkit:InvertedBoolConverter}}">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{StaticResource Outline}" />
                                        </Image.Behaviors>
                                    </Image>
                                    <Image Source="check_circle.svg"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           IsVisible="{Binding HasSpecialChar}">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{StaticResource Success}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Grid>
                                <Label Text="Pelo menos um caractere especial"
                                       Style="{StaticResource Caption}"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasSpecialChar}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource SuccessText}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasSpecialChar}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Campo 2: Confirmar Senha -->
                        <controls:AppEntry Label="Confirmar nova senha"
                                           Placeholder="Repita a nova senha"
                                           IsPassword="True"
                                           ReturnType="Done"
                                           Text="{Binding ConfirmPassword, Mode=TwoWay}" />

                        <!-- Indicador de Coincidência de Senhas -->
                        <HorizontalStackLayout Spacing="8"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding ShowMatchIndicator}">
                            <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                <Image Source="alert_circle.svg"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       IsVisible="{Binding PasswordsMatch, Converter={toolkit:InvertedBoolConverter}}">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Error}" />
                                    </Image.Behaviors>
                                </Image>
                                <Image Source="check_circle.svg"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       IsVisible="{Binding PasswordsMatch}">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Success}" />
                                    </Image.Behaviors>
                                </Image>
                            </Grid>
                            <Label VerticalOptions="Center"
                                   Style="{StaticResource Caption}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding PasswordsMatch}" Value="True">
                                        <Setter Property="Text" Value="As senhas coincidem" />
                                        <Setter Property="TextColor" Value="{StaticResource SuccessText}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding PasswordsMatch}" Value="False">
                                        <Setter Property="Text" Value="As senhas não coincidem" />
                                        <Setter Property="TextColor" Value="{StaticResource Error}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>

                        <!-- Ações -->
                        <VerticalStackLayout Spacing="12">
                            <!-- Botão Principal -->
                            <Button Style="{StaticResource PrimaryButton}"
                                    Text="Redefinir senha"
                                    Command="{Binding ResetPasswordCommand}"
                                    IsEnabled="{Binding CanSubmit}"
                                    HorizontalOptions="Fill" />

                            <!-- Botão Secundário / Voltar -->
                            <Button Style="{StaticResource LinkButton}"
                                    Text="Voltar para o login"
                                    Command="{Binding GoBackCommand}"
                                    HorizontalOptions="Center" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
