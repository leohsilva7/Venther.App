<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:Venther.App.Controls"
             xmlns:vm="clr-namespace:Venther.App.ViewModels"
             x:Class="Venther.App.Views.Devices.RegisterDevicePage"
             x:DataType="vm:RegisterDeviceViewModel"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto"
          Padding="20, 16, 20, 24"
          RowSpacing="20">

        <!-- Header + StepProgress -->
        <VerticalStackLayout Grid.Row="0" Spacing="16">
            <!-- Header bar with back button -->
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                <Border Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        Stroke="{StaticResource AuthBorder}"
                        BackgroundColor="{StaticResource White}"
                        VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.04" Offset="0, 1" Radius="2" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Image Source="arrow_left.svg"
                           WidthRequest="18"
                           HeightRequest="18"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{StaticResource OnSurface}" />
                        </Image.Behaviors>
                    </Image>
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Cadastrar Dispositivo"
                           FontFamily="InterSemiBold"
                           FontSize="20"
                           TextColor="{StaticResource OnSurface}" />
                    <Label Text="Identifique o cliente e o local de instalação"
                           Style="{StaticResource BodySmall}"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Grid>

            <!-- StepProgress Control -->
            <controls:StepProgress CurrentStep="1" TotalSteps="3" />
        </VerticalStackLayout>

        <!-- Main Form Card in ScrollView -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <Border BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource AuthBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.05" Offset="0, 2" Radius="4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">

                    <!-- Field 1: Atribuir Cliente -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Atribuir Cliente"
                               FontFamily="InterMedium"
                               FontSize="14"
                               TextColor="{StaticResource AuthText}" />

                        <controls:AppEntry Placeholder="Buscar ou digitar nome do cliente..."
                                           Text="{Binding ClientName, Mode=TwoWay}"
                                           LeadingIconSource="search.svg"
                                           ReturnType="Next" />

                        <!-- Suggestion Chips -->
                        <FlexLayout BindableLayout.ItemsSource="{Binding SuggestedClients}"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="Start"
                                    AlignItems="Center"
                                    Margin="0, 4, 0, 0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border BackgroundColor="{StaticResource Surface}"
                                            Stroke="{StaticResource AuthBorder}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="12, 6"
                                            Margin="0, 0, 8, 8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RegisterDeviceViewModel}}, Path=SelectClientCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding .}"
                                               FontFamily="InterMedium"
                                               FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariant}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Color="{StaticResource AuthBorder}" Margin="0, 4" />

                    <!-- Field 2: Local de Instalação / Apelido -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Local de Instalação / Apelido"
                               FontFamily="InterMedium"
                               FontSize="14"
                               TextColor="{StaticResource AuthText}" />

                        <controls:AppEntry Placeholder="Ex: Chiller 04 - Cobertura"
                                           Text="{Binding InstallationLocation, Mode=TwoWay}"
                                           ReturnType="Done" />

                        <Label Text="Este nome ajudará a identificar rapidamente o equipamento nos alertas e relatórios."
                               Style="{StaticResource Caption}"
                               TextColor="{StaticResource OnSurfaceVariant}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <!-- Button "Avançar" (Disabled until both fields are populated) -->
        <Button Grid.Row="2"
                Text="Avançar"
                Command="{Binding AdvanceCommand}"
                IsEnabled="{Binding CanProceed}"
                Style="{StaticResource PrimaryButton}"
                CornerRadius="12">
            <Button.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
                <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                    <Setter Property="Opacity" Value="1.0" />
                </Trigger>
            </Button.Triggers>
        </Button>

    </Grid>
</ContentPage>
